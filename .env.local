# Environment variables for Development environment # (copy this file to .env and customize the values as needed for your development environment).
# Do not commit the secret keys to version control. Use .env.local for local development and .env.production for production environment.

# Environment variable to specify the current environment (e.g., development, staging, production)
REACT_APP_ENV = development

# API URL for development environment
REACT_APP_API_URL=http://localhost:3000/api

# Feature flag to enable new UI components
REACT_APP_APP_NAME = My React App

# Log level for debugging (e.g., debug, info, warn, error)
REACT_APP_LOG_LEVEL= debug

# Enable analytics tracking
REACT_APP_ENABLE_ANALYTICS = true
