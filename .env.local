# Personal environment label override shown by the banner.
REACT_APP_ENV=development

# Personal API URL override that wins over shared defaults.
REACT_APP_API_URL=

# Personal app name override for this machine.
REACT_APP_APP_NAME=My React App

# Personal log threshold override for local testing.
REACT_APP_LOG_LEVEL=debug

# Personal analytics flag override for this machine.

REACT_APP_ENABLE_ANALYTICS=true