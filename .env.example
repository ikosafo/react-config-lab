# Copy this file to `.env.local` and update the values for your machine.
# Keep the example values below safe for local development and sharing.

# Current environment used by appConfig.js, ConfigViewer.js, EnvironmentBanner.js, logger.js, and apiService.js
REACT_APP_ENV=development

# Backend API endpoint URL used by appConfig.js and apiService.js
REACT_APP_API_URL=https://api.example.com/v1

# Application display name used by appConfig.js and ConfigViewer.js
REACT_APP_APP_NAME=React Config Lab

# Console log level used by appConfig.js and logger.js
REACT_APP_LOG_LEVEL=info

# Analytics toggle used by appConfig.js and ConfigViewer.js
REACT_APP_ENABLE_ANALYTICS=false
