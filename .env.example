# 
# Used by: appConfig.js, ConfigViewer.js, EnvironmentBanner.js, logger.js, apiService.js
REACT_APP_ENV=development

# The API endpoint URL for backend requests
# Used by: appConfig.js, apiService.js
REACT_APP_API_URL=http://localhost:3001/api

# The application name displayed in UI
# Used by: appConfig.js, ConfigViewer.js
REACT_APP_APP_NAME=React Config Lab

# Log level for console output (debug, info, warn, error)
# Used by: appConfig.js, logger.js
REACT_APP_LOG_LEVEL=debug

# Enable or disable analytics features (true or false)
# Used by: appConfig.js, ConfigViewer.js
REACT_APP_ENABLE_ANALYTICS=false
