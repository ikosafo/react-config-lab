# Copy this file to .env.local and update the values for your machine.
# .env.local is for personal overrides and takes precedence over shared defaults.
# .env.development is used for team defaults during local development.
# .env.production is used as the default set of values for production builds.

# Label used by the environment banner and environment-specific UI.
REACT_APP_ENV=development

# Base URL for API requests made by src/services/apiService.js.
REACT_APP_API_URL=https://api.example.local

# Display name for the app shown in config output and validation.
REACT_APP_APP_NAME=React Config Lab

# Minimum log level used by src/utils/logger.js: debug, info, warn, or error.
REACT_APP_LOG_LEVEL=info

# Enables or disables analytics-related behavior in the app config.
REACT_APP_ENABLE_ANALYTICS=false
