# # Label used by the environment banner during local development.
# REACT_APP_ENV=development

# # Base URL for API requests when using shared development defaults.
# REACT_APP_API_URL=http://localhost:3001/api

# # App name shown in config output for the development defaults.
# REACT_APP_APP_NAME=React Config Lab Dev

# # Lowest log level printed by the logger in development.
# REACT_APP_LOG_LEVEL=warn

# # Enables analytics-related behavior in the shared development defaults.
# REACT_APP_ENABLE_ANALYTICS=false
